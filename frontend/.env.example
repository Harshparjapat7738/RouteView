# RouteView frontend environment variables
# Copy to `.env.local` and fill in values. Never commit real values.
#
# SECURITY: every variable prefixed with VITE_ is embedded into the JavaScript
# bundle and is PUBLIC. Never put a backend secret, database credential or
# unrestricted API key in a VITE_ variable.

# Base path or URL of the RouteView backend API.
# Default "/api" works with the Vite dev proxy and with same-origin deployments.
VITE_API_BASE_URL=/api

# Backend address used only by the Vite dev server proxy (not exposed to the browser).
DEV_BACKEND_URL=http://localhost:8080

# Google Maps browser key (map display + location search). Public once deployed,
# so it MUST be restricted in Google Cloud: HTTP referrers (your dev/prod domains
# only) and API restriction = Maps JavaScript API + Places API (New) only.
# See docs/google-cloud-setup.md.
# Use a different key from the one the backend will use for server-side calls.
VITE_GOOGLE_MAPS_API_KEY=your-browser-restricted-google-maps-key

# Optional Google Maps Map ID (not a secret). Required by the marker library;
# defaults to Google's DEMO_MAP_ID, which is meant for development only.
# Create your own Map ID in Google Cloud for production.
# VITE_GOOGLE_MAPS_MAP_ID=

# Optional initial map view (defaults: centre of India, zoom 5).
# VITE_MAP_DEFAULT_LAT=22.5937
# VITE_MAP_DEFAULT_LNG=78.9629
# VITE_MAP_DEFAULT_ZOOM=5
