# RouteView backend environment variables
# Copy to `backend/.env` for local development (git-ignored), or set them as real
# environment variables. Real environment variables always take precedence.
# Never commit real values.

# Spring profile: dev (default) | test | prod
SPRING_PROFILES_ACTIVE=dev

# HTTP port of the API.
SERVER_PORT=8080

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty in development (the Vite dev server proxies /api).
# Required in prod when the frontend is served from a different origin.
# Explicit origins only, comma-separated; "*" is rejected. Required in prod.
CORS_ALLOWED_ORIGINS=

# Server-side Google Maps Platform key, used by the backend for the Routes API.
# Must be a DIFFERENT key from the frontend browser key. Restrict it in Google Cloud:
#   - API restriction: Routes API only (add other services only when they are implemented)
#   - Application restriction: IP addresses of the server (none in local development).
#     Do NOT use HTTP-referrer restrictions on this key: server requests have no referrer and would be rejected.
# Without it, route calculation answers 503 "Route calculation is currently unavailable."
GOOGLE_MAPS_SERVER_API_KEY=

# PostgreSQL + PostGIS (local development database: `docker compose up -d` in this directory).
# docker compose reads this same file. Set a strong password of your own: there is no default,
# and the application will not start without POSTGRES_PASSWORD.
POSTGRES_DB=routeview
POSTGRES_USER=routeview
POSTGRES_PASSWORD=
# Host and port the backend connects to. POSTGRES_PORT is also the port docker publishes (on localhost only).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: use another PostGIS image (default postgis/postgis:16-3.4).
# POSTGIS_IMAGE=

# --- Area import (only used by the explicit command `gradlew importAreas`, never at startup) ---
# Region to import as a bounding box: south,west,north,east in degrees (WGS 84), e.g. 28.30,77.20,28.50,77.45
# Must not be wider/taller than AREA_IMPORT_MAX_SPAN_DEGREES.
AREA_IMPORT_REGION=
# Alternative: path of a saved Overpass XML file to import instead of calling Overpass.
AREA_IMPORT_SOURCE_FILE=
# Optional overrides (defaults: public Overpass server, 200 per batch, max span 1.0 degree).
# AREA_IMPORT_OVERPASS_URL=https://overpass-api.de/api/interpreter
# AREA_IMPORT_BATCH_SIZE=200
# AREA_IMPORT_MAX_SPAN_DEGREES=1.0
# AREA_IMPORT_MIN_AREA_SQUARE_METERS=500
# AREA_IMPORT_MAX_AREA_SQUARE_KILOMETERS=150000

# --- Area Detection Engine (optional; defaults are documented in docs/area-detection.md) ---
# AREA_DETECTION_TOLERANCE_METERS=30
# AREA_DETECTION_MIN_CROSSING_METERS=250
# AREA_DETECTION_MIN_CROSSING_FLOOR_METERS=60
# AREA_DETECTION_BOUNDARY_BAND_METERS=12

# Optional: largest accepted /api request body in bytes
# MAX_REQUEST_BODY_BYTES=16384

# --- Metro import (only used by the explicit command `gradlew importMetro`, never at startup) ---
# Put the DMRC GTFS dataset you downloaded from the Delhi Open Transit Data portal (the .zip, or its unzipped
# folder) into backend/metro.data/ and leave METRO_IMPORT_SOURCE_FILE unset. Check the portal's terms of use first;
# the dataset is git-ignored. See docs/metro.md.
# Only set this to import from somewhere else (a .zip, or a folder containing stops.txt):
# METRO_IMPORT_SOURCE_FILE=
# Required: version label / publication date of that dataset, stored with every record.
METRO_IMPORT_SOURCE_VERSION=2023-08-10
# Optional: the publisher's update date (yyyy-MM-dd).
METRO_IMPORT_SOURCE_UPDATED_AT=2023-08-10
# Not needed in .env (defaults are used): METRO_IMPORT_SOURCE (dataset family, default DMRC_GTFS),
# METRO_IMPORT_CLUSTER_METERS (300) and METRO_IMPORT_MAX_STATION_GAP_METERS (40000).
# The dataset's service period and operating days are read from its own calendar.txt - there is nothing to set.
# The import also needs the normal database settings above (POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD). No other secret is used.

# --- Bus import (only used by the explicit command `gradlew importBus`, never at startup) ---
# The Delhi bus GTFS dataset (DTC + DIMTS) is read from backend/metro.data/bus/ (git-ignored); leave BUS_IMPORT_SOURCE_FILE unset.
# Only set it to import from somewhere else (a .zip, or a folder containing stops.txt):
# BUS_IMPORT_SOURCE_FILE=
# Required: version label / publication date of that dataset, stored with every record. The dataset itself states neither,
# so use the date you downloaded it or the portal's label.
BUS_IMPORT_SOURCE_VERSION=
# Optional: the publisher's update date (yyyy-MM-dd).
BUS_IMPORT_SOURCE_UPDATED_AT=
# Not needed in .env (defaults are used): BUS_IMPORT_SOURCE (dataset family, default DELHI_BUS_GTFS) and BUS_IMPORT_BATCH_SIZE (5000).
# The service period and operating days are read from the dataset's own calendar.txt. The import also needs the normal database
# settings above. No other secret is used.
